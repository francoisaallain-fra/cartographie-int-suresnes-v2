{
  "name": "cartographie-int-suresnes-v2",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "node scripts/check-isolation.mjs && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test tests/*.test.js",
    "lint": "eslint src tests scripts",
    "format": "prettier --write src tests scripts index.html docs README.md",
    "format:check": "prettier --check src tests scripts index.html docs README.md",
    "check": "pnpm lint && pnpm test && pnpm build",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "eslint": "10.14.0",
    "prettier": "3.9.10",
    "vite": "8.3.5"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@11.25.0"
}
